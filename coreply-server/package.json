{
  "name": "vite-react-template",
  "description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
  "cloudflare": {
    "label": "Vite React Template",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "autumn-js": "^1.5.77",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "coreply-shared-components": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "4.11.1",
    "libcoreply": "workspace:*",
    "lucide-react": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "uniwind": "^1.10.1",
    "vite": "^8.0.0",
    "vite-plugin-rnw": "^0.0.12",
    "wrangler": "4.146.0"
  },
  "private": true,
  "scripts": {
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "test:auth": "node --test tests/auth-session.test.mjs",
    "auth:generate": "auth generate --config ./auth-schema.config.ts --output ./src/worker/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply coreply-cloud --local",
    "db:migrate:remote": "wrangler d1 migrations apply coreply-cloud --remote",
    "build": "pnpm run i18n:compile && tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "npm run build && vite preview"
  },
  "type": "module"
}
