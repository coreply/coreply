{
  "expo": {
    "name": "coreply-app",
    "slug": "coreply-app",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-foreground.png",
    "scheme": "coreplyapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F7",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon-foreground.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/outfit/400Regular/Outfit_400Regular.ttf"
          ]
        }
      ],
      "expo-brownfield"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
