EXPO_PUBLIC_COREPLY_CLOUD_URL=http://localhost:5173
# Optional post-sign-in destination. Defaults to /.
EXPO_PUBLIC_COREPLY_CLOUD_CALLBACK_URL=/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Required only for iOS. Configure the corresponding reversed-client-ID URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# RevenueCat public SDK key (test_ for Test Store, goog_ for Google Play).
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-sdk-key
# Set variant=web or variant=rc in the build environment for Metro and native autolinking.
