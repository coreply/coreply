{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*",
         "../coreply-shared-components/src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/modules/*": [
        "./modules/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
