  "scripts": {
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "start": "expo start",
    "android": "expo start --android",
    "run:android": "cd android && ./gradlew installDebug -PreactNativeArchitectures=arm64-v8a",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "pnpm run i18n:compile && variant=web expo export --platform web --output-dir ../coreply-browser-extension/entrypoints/popup/ --clear"
